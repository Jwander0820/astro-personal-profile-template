{
  "name": "astro-personal-profile-template",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "studio": "node scripts/studio-server.mjs",
    "profile:apply": "node scripts/apply-profile.mjs",
    "build": "astro check && astro build && npm run check:ui && npm run check:profile-tools && npm run check:template-safety",
    "check:ui": "node scripts/verify-ui-contracts.mjs",
    "check:profile-tools": "node scripts/verify-profile-tools.mjs",
    "check:template-safety": "node scripts/verify-template-safety.mjs",
    "check:template-defaults": "node scripts/verify-template-defaults.mjs",
    "check:template": "npm run check:template-defaults && npm run check:template-safety",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-satteri": "^0.3.4",
    "astro": "^7.1.3",
    "typescript": "^5.7.2"
  }
}
