{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/profile-answers.schema.json",
  "title": "Personal profile interview answers",
  "$defs": {
    "imageSource": {
      "type": "string",
      "maxLength": 2048,
      "description": "專案 /images/ 路徑或公開 HTTPS 圖片網址",
      "anyOf": [
        {
          "pattern": "^/images/[A-Za-z0-9._/-]+$",
          "not": { "pattern": "\\.\\." }
        },
        { "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]://" }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "allOf": [
    {
      "if": {
        "required": ["applyMode"],
        "properties": { "applyMode": { "const": "merge" } }
      },
      "else": {
        "required": ["identity"],
        "properties": {
          "identity": { "required": ["displayName"] }
        },
        "allOf": [
          {
            "if": { "required": ["fortune"] },
            "then": {
              "properties": {
                "fortune": { "required": ["fortunes"] }
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "applyMode": {
      "enum": ["merge", "replace"],
      "default": "replace",
      "description": "replace 會以回答檔取代可管理集合；merge 只更新回答檔明確提供的頂層欄位。"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 },
        "title": { "type": ["string", "number"], "maxLength": 120 },
        "location": { "type": ["string", "number", "null"], "maxLength": 100 },
        "tagline": { "type": "array", "maxItems": 6, "uniqueItems": true, "items": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 } },
        "bio": { "type": ["string", "number"], "maxLength": 5000 }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "avatar": { "$ref": "#/$defs/imageSource" },
        "background": { "$ref": "#/$defs/imageSource" }
      }
    },
    "socials": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "url"],
        "properties": {
          "service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": ["string", "number"], "maxLength": 80 },
          "url": { "type": "string", "maxLength": 500 },
          "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 },
          "url": { "type": "string", "maxLength": 500 },
          "description": { "type": ["string", "number"], "minLength": 1, "maxLength": 500 },
          "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "style": { "enum": ["primary", "normal", "subtle"], "default": "normal" },
          "tags": { "type": "array", "maxItems": 6, "items": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 } }
        }
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 },
          "description": { "type": ["string", "number"], "minLength": 1, "maxLength": 2000 },
          "tags": { "type": "array", "maxItems": 8, "items": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 } },
          "image": { "$ref": "#/$defs/imageSource" }
        }
      }
    },
    "imageBlocks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "image"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 },
          "image": { "$ref": "#/$defs/imageSource" },
          "imageAlt": { "type": ["string", "number"], "maxLength": 300 },
          "description": { "type": ["string", "number"], "maxLength": 5000 },
          "placement": { "enum": ["before-links", "between-links-sections", "after-sections"], "default": "after-sections" },
          "imageLayout": { "enum": ["full", "split-left", "split-right", "poster"], "default": "full" },
          "imageAspect": { "enum": ["auto", "landscape", "square", "portrait"], "default": "landscape" },
          "imagePosition": { "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"], "default": "center" },
          "tags": { "type": "array", "maxItems": 8, "items": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 } }
        }
      }
    },
    "embedBlocks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 },
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "公開 http(s) 網址，或從 Notion／YouTube 複製的 iframe 程式碼；儲存時會正規化為網址",
            "anyOf": [
              { "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" },
              { "pattern": "^\\s*<[Ii][Ff][Rr][Aa][Mm][Ee]\\b" }
            ]
          },
          "description": { "type": ["string", "number"], "maxLength": 5000 },
          "provider": { "enum": ["website", "notion", "youtube"], "default": "website" },
          "embedMode": { "enum": ["preview", "inline"], "default": "preview" },
          "height": { "type": "integer", "minimum": 320, "maximum": 1200, "default": 600 },
          "tags": { "type": "array", "maxItems": 8, "items": { "type": ["string", "number"], "minLength": 1, "maxLength": 80 } }
        }
      }
    },
    "playlist": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["youtubePlaylistId"],
      "properties": {
        "youtubePlaylistId": {
          "type": "string",
          "maxLength": 500,
          "description": "YouTube 播放清單完整網址（可包含 si 等分享參數）或 playlist ID",
          "anyOf": [
            { "pattern": "^[A-Za-z0-9_-]{10,}$" },
            { "pattern": "^https?://(?:(?:[a-z0-9-]+\\.)*(?:youtube\\.com|youtube-nocookie\\.com)|youtu\\.be)/[^\\s]*[?&]list=[A-Za-z0-9_-]{10,}(?:[&#][^\\s]*)?$" }
          ]
        },
        "title": { "type": ["string", "number"], "maxLength": 80 },
        "description": { "type": ["string", "number"], "maxLength": 500 }
      }
    },
    "fortune": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": ["string", "number"], "maxLength": 80, "default": "今日手氣" },
        "description": { "type": ["string", "number"], "maxLength": 500, "default": "搖一搖，抽走今天的一點好運。" },
        "fortunes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "grade", "category", "message", "visible"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "grade": { "enum": ["大吉", "中吉", "小吉", "吉", "末吉", "凶", "大凶"] },
              "category": { "enum": ["blessing", "joke"] },
              "message": { "type": ["string", "number"], "minLength": 1, "maxLength": 200 },
              "note": { "type": ["string", "number"], "maxLength": 300 },
              "visible": { "type": "boolean" }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fortune": { "type": "boolean", "default": true } }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectionsLayout": { "enum": ["grid", "list"], "default": "list" },
        "bodyFont": { "enum": ["system", "noto-sans-tc", "noto-serif-tc", "lxgw-wenkai-tc"], "default": "system" },
        "displayFont": { "enum": ["system", "noto-sans-tc", "noto-serif-tc", "lxgw-wenkai-tc"], "default": "system" },
        "mainColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#7A58A6" },
        "fontScale": { "type": "number", "minimum": 0.9, "maximum": 1.2, "default": 1 },
        "smallTextScale": { "type": "number", "minimum": 0.9, "maximum": 1.35, "default": 1 },
        "homeOrder": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["about", "turntable", "links", "fortune", "notion"] }
        }
      }
    }
  }
}
