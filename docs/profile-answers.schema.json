{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/profile-answers.schema.json",
  "title": "Personal profile interview answers",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identity"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "title", "tagline", "bio"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "location": { "type": ["string", "null"], "maxLength": 100 },
        "tagline": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "bio": { "type": "string", "minLength": 1, "maxLength": 5000 }
      }
    },
    "socials": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "url"],
        "properties": {
          "service": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "maxLength": 80 },
          "url": { "type": "string", "maxLength": 500 },
          "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        }
      }
    },
    "links": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "url": { "type": "string", "maxLength": 500 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "icon": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "tags": { "type": "array", "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
        }
      }
    },
    "sections": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "image": { "type": "string", "pattern": "^/images/[A-Za-z0-9._/-]+$" }
        }
      }
    },
    "imageBlocks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "image"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "image": { "type": "string", "pattern": "^/images/[A-Za-z0-9._/-]+$" },
          "imageAlt": { "type": "string", "maxLength": 300 },
          "description": { "type": "string", "maxLength": 5000 },
          "placement": { "enum": ["before-links", "between-links-sections", "after-sections"], "default": "after-sections" },
          "imageLayout": { "enum": ["full", "split-left", "split-right", "poster"], "default": "full" },
          "imageAspect": { "enum": ["auto", "landscape", "square", "portrait"], "default": "landscape" },
          "imagePosition": { "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"], "default": "center" },
          "tags": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 80 } }
        }
      }
    },
    "playlist": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["youtubePlaylistId"],
      "properties": {
        "youtubePlaylistId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{10,}$" },
        "title": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "fortune": { "type": "boolean", "default": true } }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectionsLayout": { "enum": ["grid", "list"], "default": "grid" },
        "bodyFont": { "enum": ["system", "noto-sans-tc", "noto-serif-tc", "lxgw-wenkai-tc"], "default": "system" },
        "displayFont": { "enum": ["system", "noto-sans-tc", "noto-serif-tc", "lxgw-wenkai-tc"], "default": "system" },
        "homeOrder": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["about", "turntable", "links", "fortune", "notion"] }
        }
      }
    }
  }
}
