---
import '../styles/global.css';
import { withBase } from '../lib/paths';
import { getFontPreset, getGoogleFontsUrl } from '../lib/font-presets';
import { buildThemeCss, DEFAULT_THEME_COLOR } from '../../scripts/theme-color.mjs';
import {
  STUDIO_PREVIEW_QUERY_PARAM,
  STUDIO_PREVIEW_QUERY_VALUE,
} from '../../scripts/studio-preview-mode.mjs';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props {
  title: string;
  description: string;
  image?: string;
  pageClass?: string;
  fontScale?: number;
  smallTextScale?: number;
  bodyFont?: string;
  displayFont?: string;
  mainColor?: string;
}
const {
  title,
  description,
  image,
  pageClass,
  fontScale = 1,
  smallTextScale = 1,
  bodyFont = 'system',
  displayFont = 'system',
  mainColor = DEFAULT_THEME_COLOR,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(withBase(image) ?? '', Astro.site) : undefined;
const favicon = withBase('/favicon.svg');
const bodyFontPreset = getFontPreset(bodyFont);
const displayFontPreset = getFontPreset(displayFont);
const bodyFontFamily = bodyFont === 'system'
  ? '"Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif'
  : bodyFontPreset.cssFamily;
const displayFontFamily = displayFont === 'system'
  ? '"Noto Serif TC", "Noto Serif JP", "Yu Mincho", "Songti TC", serif'
  : displayFontPreset.cssFamily;
const googleFontsUrl = getGoogleFontsUrl(bodyFont, displayFont);
const themeCss = buildThemeCss(mainColor);
---
<!doctype html>
<html
  lang="zh-Hant"
  style={`font-size: ${fontScale * 100}%; --small-text-base: ${smallTextScale}rem; --font-body: ${bodyFontFamily}; --font-display: ${displayFontFamily};`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script
      is:inline
      define:vars={{
        studioPreviewQueryParam: STUDIO_PREVIEW_QUERY_PARAM,
        studioPreviewQueryValue: STUDIO_PREVIEW_QUERY_VALUE,
      }}
    >
      (function() {
        if (new URLSearchParams(window.location.search).get(studioPreviewQueryParam) === studioPreviewQueryValue) {
          document.documentElement.dataset.studioPreview = 'true';
        }
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.setAttribute('data-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <style is:inline id="profile-theme-css" set:html={themeCss}></style>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    {googleFontsUrl && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href={googleFontsUrl} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <ThemeToggle />
    <main id="main-content" tabindex="-1"><slot /></main>
    <script>
      import '../scripts/profile-preview-bridge.js';
    </script>
  </body>
</html>
