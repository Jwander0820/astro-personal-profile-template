---
import '../styles/global.css';
import { withBase } from '../lib/paths';
interface Props {
  title: string;
  description: string;
  image?: string;
  pageClass?: string;
  fontScale?: number;
  smallTextScale?: number;
}
const {
  title,
  description,
  image,
  pageClass,
  fontScale = 1,
  smallTextScale = 1,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(withBase(image) ?? '', Astro.site) : undefined;
const favicon = withBase('/favicon.svg');
---
<!doctype html>
<html
  lang="zh-Hant"
  style={`font-size: ${fontScale * 100}%; --small-text-base: ${smallTextScale}rem;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <title>{title}</title>
  </head>
  <body class={pageClass}><main><slot /></main></body>
</html>
