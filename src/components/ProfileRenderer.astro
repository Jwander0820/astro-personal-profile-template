---
import type { CollectionEntry } from 'astro:content';
import CustomBlock from './CustomBlock.astro';
import EntryBody from './EntryBody.astro';
import ProfileView from './ProfileView.astro';
import { createShareProfile } from '../../scripts/profile-sharing.mjs';
import { arrangeHome, slot } from '../../scripts/profile-view.mjs';
import { withBase } from '../lib/paths';
import { views } from '../lib/profile-views.js';

interface Props {
  profile: CollectionEntry<'profile'>;
  links: CollectionEntry<'links'>[];
  sections: CollectionEntry<'sections'>[];
  blocks: CollectionEntry<'blocks'>[];
  fortunes: CollectionEntry<'fortunes'>[];
  turntableTemplate?: CollectionEntry<'blocks'>;
  fortuneTemplate?: CollectionEntry<'blocks'>;
  studioEnabled?: boolean;
  studioHref?: string;
}
type HomeItem = { kind: 'about' } | { kind: 'links' } | { kind: 'block'; block: CollectionEntry<'blocks'> };

const {
  profile,
  links,
  sections,
  blocks,
  fortunes,
  turntableTemplate,
  fortuneTemplate,
  studioEnabled = false,
  studioHref = '/studio/',
} = Astro.props;
const { tagline } = profile.data;
const iconLinks = links.filter((link) => link.data.group !== 'footer' && link.data.layout === 'icon');
const featuredLinks = links.filter((link) => ['main', 'featured'].includes(link.data.group) && link.data.layout === 'card');
const blocksOf = (layout: string) => blocks.filter((block) => block.data.layout === layout);
const featureLayouts = ['turntable', 'fortune', 'embed'];
const freeBlocks = blocks.filter((block) => !featureLayouts.includes(block.data.layout) && (block.data.layout !== 'image' || profile.data.showImages));
const visibleHomeSections = profile.data.homeOrder.filter((section) => profile.data.homeVisibility.includes(section) && !profile.data.hiddenSections.includes(section));
const blockItem = (block: CollectionEntry<'blocks'>): HomeItem => ({ kind: 'block', block });
// Markup and ordering come from scripts/profile-view.mjs, shared with the
// Studio live preview. This file only maps content entries onto those views.
const homeItems = arrangeHome({
  sections: visibleHomeSections,
  parts: {
    about: sections.length > 0 && { kind: 'about' },
    turntable: blocksOf('turntable').map(blockItem),
    links: (featuredLinks.length > 0 || studioEnabled) && { kind: 'links' },
    fortune: blocksOf('fortune').map(blockItem),
    notion: blocksOf('embed').map(blockItem),
  },
  blocks: freeBlocks.map((block) => ({ placement: block.data.placement, view: blockItem(block) })),
}) as HomeItem[];
const headerView = views.profileHeader({
  displayName: profile.data.displayName,
  title: profile.data.title,
  location: profile.data.location,
  tagline: Array.isArray(tagline) ? tagline : (tagline ?? '').split(',').map((item) => item.trim()).filter(Boolean),
  avatarUrl: withBase(profile.data.avatar),
  backgroundUrl: withBase(profile.data.background),
  bio: slot('body'),
});
const socialsView = views.socials(iconLinks.map((link) => ({
  title: link.data.title,
  url: link.data.url,
  icon: link.data.icon,
  imageUrl: withBase(link.data.image),
})));
---
<div
  data-profile-renderer
  data-share-profile={JSON.stringify(createShareProfile({ identity: { ...profile.data, bio: profile.body }, media: profile.data, appearance: profile.data, sharing: profile.data.sharing, socials: iconLinks.map((item) => item.data) }, withBase))}
  data-studio-enabled={String(studioEnabled)}
  data-studio-href={studioHref}
>
  <ProfileView view={headerView}><EntryBody slot="body" entry={profile} /></ProfileView>
  <ProfileView view={socialsView} />
  {homeItems.map((item) => item.kind === 'about' ? (
    <ProfileView view={views.aboutSection({ heading: profile.data.aboutHeading, layout: profile.data.sectionsLayout, cards: slot('cards') })}>
      <Fragment slot="cards">
        {sections.map((section) => (
          <ProfileView view={views.sectionCard({ title: section.data.title, imageUrl: withBase(section.data.image), tags: section.data.tags, body: slot('body') })}>
            <EntryBody slot="body" entry={section} />
          </ProfileView>
        ))}
      </Fragment>
    </ProfileView>
  ) : item.kind === 'links' ? (
    <ProfileView view={views.linksSection({ heading: profile.data.linksHeading, cards: slot('cards'), studioOnly: featuredLinks.length === 0 })}>
      <Fragment slot="cards">
        {featuredLinks.map((link) => (
          <ProfileView view={views.linkCard({ title: link.data.title, url: link.data.url, style: link.data.style, imageUrl: withBase(link.data.image), icon: link.data.icon, tags: link.data.tags, body: slot('body') })}>
            <EntryBody slot="body" entry={link} />
          </ProfileView>
        ))}
        {studioEnabled && <ProfileView view={views.studioLinkCard(studioHref)} />}
      </Fragment>
    </ProfileView>
  ) : (
    <CustomBlock block={item.block} fortunes={fortunes} />
  ))}
  <ProfileView view={views.footer({ name: profile.data.displayName, studioEnabled, studioHref })} />
</div>
{studioEnabled && turntableTemplate && (
  <template id="studio-turntable-template"><CustomBlock block={turntableTemplate} /></template>
)}
{studioEnabled && fortuneTemplate && (
  <template id="studio-fortune-template"><CustomBlock block={fortuneTemplate} fortunes={fortunes} /></template>
)}
