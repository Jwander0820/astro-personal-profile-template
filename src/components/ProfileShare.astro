---
import '../styles/share-card.css';
---
<button id="profile-share-toggle" class="profile-share-toggle" type="button" aria-label="顯示網站 QR Code" title="顯示網站 QR Code" aria-haspopup="dialog" aria-controls="profile-share-dialog" hidden>
  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="3"/><circle cx="8" cy="10" r="2"/><path d="M5 16c0-3 6-3 6 0m3-7h5m-5 4h5m-5 4h3"/></svg>
</button>
<dialog id="profile-share-dialog" class="profile-share-dialog" aria-labelledby="profile-share-title" closedby="any">
  <div class="share-dialog-heading"><h2 id="profile-share-title">網站 QR Code</h2><form method="dialog"><button type="submit" autofocus aria-label="關閉 QR Code">關閉 ✕</button></form></div>
  <div class="profile-qr-stage" data-profile-qr-stage aria-busy="false"></div>
  <p class="share-card-status" data-profile-qr-status role="status" aria-live="polite"></p>
  <a class="profile-qr-link" data-profile-qr-link hidden></a>
</dialog>
<script>
  import { mountProfileShare } from '../scripts/profile-qr.js';
  mountProfileShare();
</script>
