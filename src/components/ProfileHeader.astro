---
import { render, type CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';
interface Props { profile: CollectionEntry<'profile'>; }
const { profile } = Astro.props;
const { Content } = await render(profile);
const { displayName, title, avatar, background, location, tagline, archiveLabel } = profile.data;
const avatarUrl = withBase(avatar);
const backgroundUrl = withBase(background);
const taglineItems = Array.isArray(tagline)
  ? tagline
  : tagline.split(',').map((item) => item.trim()).filter(Boolean);
---
<header class="profile" style={backgroundUrl ? `--cover-image: url('${backgroundUrl}')` : undefined}>
  {archiveLabel && <span class="profile-archive-label">{archiveLabel}</span>}
  <div class="cover" aria-hidden="true"></div>
  <div class="profile-body">
    {avatarUrl ? <img class="avatar" src={avatarUrl} alt={`${displayName} 的頭像`} width="112" height="112" /> : <span class="avatar avatar-fallback">{displayName.slice(0, 2)}</span>}
    <div class="identity">
      <h1>{displayName}</h1>
      {location && <p class="location">{location}</p>}
    </div>
    <p class="role">{title}</p>
    <ul class="tagline-list" aria-label="個人標籤">
      {taglineItems.map((item) => <li class="tagline">{item}</li>)}
    </ul>
    <div class="bio"><Content /></div>
  </div>
</header>
