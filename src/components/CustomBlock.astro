---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/paths';
import { views } from '../lib/profile-views.js';
import { slot } from '../../scripts/profile-view.mjs';
import EntryBody from './EntryBody.astro';
import FortuneDraw from './FortuneDraw.astro';
import ProfileView from './ProfileView.astro';
import TurntablePlayer from './TurntablePlayer.astro';

interface Props {
  block: CollectionEntry<'blocks'>;
  fortunes?: CollectionEntry<'fortunes'>[];
}
const { block, fortunes = [] } = Astro.props;
const { data } = block;
const isTurntable = data.layout === 'turntable' && Boolean(data.playlistId);
const isFortune = data.layout === 'fortune';
// Structure, embed policy and copy live in scripts/profile-view.mjs so the
// Studio preview renders the same block.
const view = views.customBlock({
  id: block.id,
  layout: data.layout,
  title: data.title,
  image: {
    url: withBase(data.image),
    alt: data.imageAlt,
    layout: data.imageLayout,
    aspect: data.imageAspect,
    position: data.imagePosition,
  },
  body: slot('body'),
  feature: (isTurntable || isFortune) && slot('feature'),
  embed: { url: data.url, provider: data.provider, mode: data.embedMode, height: data.height },
  tags: data.tags,
});
---
<ProfileView view={view}>
  <EntryBody slot="body" entry={block} />
  <Fragment slot="feature">
    {isTurntable && data.playlistId && (
      <TurntablePlayer
        playlistId={data.playlistId}
        title={data.title}
        continuousPlayback={data.continuousPlayback}
      />
    )}
    {isFortune && <FortuneDraw fortunes={fortunes} />}
  </Fragment>
</ProfileView>
