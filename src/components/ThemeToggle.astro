---
---
<button id="theme-toggle" class="theme-toggle-btn" aria-label="切換亮暗主題" title="切換亮暗主題">
  <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const currentTheme = document.documentElement.getAttribute('data-theme');
      let nextTheme = 'light';

      if (currentTheme === 'light') {
        nextTheme = 'dark';
      } else if (currentTheme === 'dark') {
        nextTheme = 'light';
      } else {
        // 如果目前沒有 data-theme 屬性（即初次進入、使用 prefers-color-scheme 自動切換）
        const isSystemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        nextTheme = isSystemDark ? 'light' : 'dark';
      }

      document.documentElement.setAttribute('data-theme', nextTheme);
      localStorage.setItem('theme', nextTheme);
    });
  }
</script>

<style>
  .theme-toggle-btn {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 99;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    cursor: pointer;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--card);
    box-shadow: 0 8px 22px var(--social-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--ink);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.2s ease, background-color 0.2s ease;
  }

  .theme-toggle-btn:hover {
    transform: translateY(-2px) scale(1.05);
    border-color: var(--social-hover-border);
    background: var(--social-hover-bg);
  }

  .theme-toggle-btn:active {
    transform: translateY(0) scale(0.95);
  }

  .theme-toggle-btn svg {
    position: absolute;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }

  /* 亮色模式：太陽顯示，月亮隱藏並旋轉 */
  .theme-toggle-btn .sun {
    opacity: 1;
    transform: rotate(0deg);
  }

  .theme-toggle-btn .moon {
    opacity: 0;
    transform: rotate(90deg);
  }

  /* 暗色模式：太陽隱藏並旋轉，月亮顯示 */
  :root[data-theme="dark"] .theme-toggle-btn .sun {
    opacity: 0;
    transform: rotate(-90deg);
  }

  :root[data-theme="dark"] .theme-toggle-btn .moon {
    opacity: 1;
    transform: rotate(0deg);
  }

  /* 系統偏好為暗色且沒有手動覆寫成亮色 */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .theme-toggle-btn .sun {
      opacity: 0;
      transform: rotate(-90deg);
    }
    :root:not([data-theme="light"]) .theme-toggle-btn .moon {
      opacity: 1;
      transform: rotate(0deg);
    }
  }

  @media (max-width: 480px) {
    .theme-toggle-btn {
      top: 1rem;
      right: 1rem;
      width: 40px;
      height: 40px;
    }
  }
</style>
