---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileHeader from '../components/ProfileHeader.astro';
import SocialIcons from '../components/SocialIcons.astro';
import LinkCard from '../components/LinkCard.astro';
import SectionCard from '../components/SectionCard.astro';
import Footer from '../components/Footer.astro';
import CustomBlock from '../components/CustomBlock.astro';
import { getBlocks, getLinks, getProfile, getSections } from '../lib/content';

const profile = await getProfile();
const links = await getLinks();
const sections = await getSections();
const blocks = await getBlocks();
const iconLinks = links.filter((link) => link.data.group !== 'footer' && link.data.layout === 'icon');
const featuredLinks = links.filter((link) => ['main', 'featured'].includes(link.data.group) && link.data.layout === 'card');
const turntableBlocks = blocks.filter((block) => block.data.layout === 'turntable');
const notionBlocks = blocks.filter((block) => block.data.layout === 'embed' && block.data.provider === 'notion');
const orderedBlockIds = new Set([...turntableBlocks, ...notionBlocks].map((block) => block.id));
const remainingBlocks = blocks.filter((block) => !orderedBlockIds.has(block.id));
const taglineText = Array.isArray(profile.data.tagline)
  ? profile.data.tagline.join(', ')
  : profile.data.tagline;
const description = `${profile.data.displayName} — ${profile.data.title}。${taglineText}`;
---
<BaseLayout
  title={`${profile.data.displayName} · ${profile.data.title}`}
  description={description}
  image={profile.data.background}
  fontScale={profile.data.fontScale}
  smallTextScale={profile.data.smallTextScale}
>
  <ProfileHeader profile={profile} />
  <SocialIcons links={iconLinks} />
  {profile.data.homeOrder.map((section) => (
    section === 'about' ? sections.length > 0 && (
      <section class="content-section" aria-labelledby="about-heading">
        <h2 id="about-heading">About me</h2>
        <div class:list={['section-list', `section-list--${profile.data.sectionsLayout}`]}>
          {sections.map((item) => <SectionCard section={item} />)}
        </div>
      </section>
    ) : section === 'turntable' ? (
      turntableBlocks.map((block) => <CustomBlock block={block} />)
    ) : section === 'links' ? (
      featuredLinks.length > 0 && (
        <section class="content-section" aria-labelledby="links-heading">
          <h2 id="links-heading">Links</h2>
          <div class="link-list">{featuredLinks.map((link) => <LinkCard link={link} />)}</div>
        </section>
      )
    ) : (
      notionBlocks.map((block) => <CustomBlock block={block} />)
    )
  ))}
  {remainingBlocks.map((block) => <CustomBlock block={block} />)}
  <Footer name={profile.data.displayName} />
</BaseLayout>
