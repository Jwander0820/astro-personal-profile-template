---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileRenderer from '../components/ProfileRenderer.astro';
import { getBlock, getBlocks, getFortunes, getLinks, getProfile, getSections } from '../lib/content';
import { withBase } from '../lib/paths';
import { resolveOnlineStudioAccess } from '../../scripts/studio-access.mjs';

const profile = await getProfile();
const links = await getLinks();
const sections = await getSections();
const blocks = await getBlocks();
const turntableTemplate = await getBlock('turntable');
const fortunes = await getFortunes();
const taglineText = Array.isArray(profile.data.tagline)
  ? profile.data.tagline.join(', ')
  : profile.data.tagline ?? '';
const identityParts = [profile.data.displayName, profile.data.title].filter(Boolean);
const description = [identityParts.join(' — '), taglineText].filter(Boolean).join('。');
const pageTitle = identityParts.join(' · ');
const runtime = globalThis as typeof globalThis & { process: { env: Record<string, string | undefined> } };
const studioHref = withBase('/studio/');
const studioEnabled = resolveOnlineStudioAccess({
  mode: runtime.process.env.ONLINE_STUDIO_MODE,
  isDev: import.meta.env.DEV,
  repository: runtime.process.env.GITHUB_REPOSITORY,
  allowedRepositories: runtime.process.env.ONLINE_STUDIO_ALLOWED_REPOSITORIES,
  siteUrl: new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url).href,
  allowedSites: runtime.process.env.ONLINE_STUDIO_ALLOWED_SITES,
});
---
<BaseLayout
  title={pageTitle}
  description={description}
  image={profile.data.background}
  fontScale={profile.data.fontScale}
  smallTextScale={profile.data.smallTextScale}
  bodyFont={profile.data.bodyFont}
  displayFont={profile.data.displayFont}
  mainColor={profile.data.mainColor}
>
  <ProfileRenderer {profile} {links} {sections} {blocks} {fortunes} {turntableTemplate} {studioEnabled} {studioHref} />
</BaseLayout>
