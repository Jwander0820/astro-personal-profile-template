---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileRenderer from '../components/ProfileRenderer.astro';
import { getBlocks, getFortunes, getLinks, getProfile, getSections } from '../lib/content';

const profile = await getProfile();
const links = await getLinks();
const sections = await getSections();
const blocks = await getBlocks();
const fortunes = await getFortunes();
const taglineText = Array.isArray(profile.data.tagline)
  ? profile.data.tagline.join(', ')
  : profile.data.tagline ?? '';
const identityParts = [profile.data.displayName, profile.data.title].filter(Boolean);
const description = [identityParts.join(' — '), taglineText].filter(Boolean).join('。');
const pageTitle = identityParts.join(' · ');
---
<BaseLayout
  title={pageTitle}
  description={description}
  image={profile.data.background}
  fontScale={profile.data.fontScale}
  smallTextScale={profile.data.smallTextScale}
  bodyFont={profile.data.bodyFont}
  displayFont={profile.data.displayFont}
  mainColor={profile.data.mainColor}
>
  <ProfileRenderer {profile} {links} {sections} {blocks} {fortunes} />
</BaseLayout>
