# Optional: use this only for a custom domain.
# SITE_URL=https://example.com

# Optional: auto (default) only publishes /studio/ for an allowed repository
# or site. public enables every deployment; off disables every deployment.
# Local `npm run studio` remains available in all three modes.
# ONLINE_STUDIO_MODE=auto

# Comma-separated exact allowlists used by auto mode. These are public build
# settings, not passwords. An unconfigured fork does not match the upstream
# repository below and therefore omits Studio routes and entry links.
# Add only sites that should expose the editor.
# ONLINE_STUDIO_ALLOWED_REPOSITORIES=Jwander0820/astro-personal-profile-template
# ONLINE_STUDIO_ALLOWED_SITES=https://jwander0820.github.io/astro-personal-profile-template
